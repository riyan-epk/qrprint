# Copy to .env and fill in. Or run: npm run setup
# ----------------------------------------------------------------------------

# 'development' (open dashboard, dev keys OK) or 'production' (strict).
NODE_ENV=production

PORT=3000

# Your public HTTPS URL in hybrid/cloud mode (the QR + payment callbacks use it).
# Leave blank in local LAN mode (the server auto-detects the LAN IP).
PUBLIC_URL=https://print.yourdomain.com

# Set to 1 when running behind Caddy/Nginx (so HTTPS + client IPs are correct).
TRUST_PROXY=1

# Secrets — MUST be long random strings in production (npm run setup makes them).
AGENT_KEY=change-me-long-random
ADMIN_KEY=change-me-long-random
SESSION_SECRET=change-me-long-random

# Payments: 'mock' (offline, always succeeds — good for demos) or 'jazzcash'.
PAYMENT_PROVIDER=mock

# JazzCash credentials (only needed when PAYMENT_PROVIDER=jazzcash).
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Sandbox by default; switch to the live URL when going live.
# JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoTransaction

# Contact details shown on the homepage, login pages and dashboard.
CONTACT_EMAIL=ryaan.epk@gmail.com
CONTACT_WHATSAPP=+92 332 522 4700

# JazzCash per-shop checkout is "coming soon" until this is set to 1 (see JAZZCASH.md).
# JAZZCASH_ENABLED=0

# Policy
MAX_UPLOAD_MB=25
GRACE_DAYS=3

# Auto-delete (optional; defaults shown)
# APPROVAL_TTL_MIN=120     # cash jobs nobody approved
# FILE_KEEP_HOURS=24       # stuck/failed files kept for Reprint
# JOB_RETENTION_DAYS=7     # job history in the dashboard
# OFFICE_CONCURRENCY=2     # Word/Excel conversions at once (each ~250 MB RAM)
